rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: stores (legacy: restaurants)
    // Fields: name, bio, logoUrl, coverUrl, slug, ownerId
    //
    // Collection: categories
    // Fields: name, order, storeId, restaurantId (legacy)
    //
    // Collection: products
    // Fields: name, description, price, imageUrl, isAvailable, categoryId, storeId, restaurantId (legacy)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "qthuan1234@gmail.com" && request.auth.token.email_verified == true));
    }

    function getStoreRef(data) {
      return data.storeId == null ? data.restaurantId : data.storeId;
    }

    function getStoreOwnerId(storeId) {
      return exists(/databases/$(database)/documents/restaurants/$(storeId))
        ? get(/databases/$(database)/documents/restaurants/$(storeId)).data.ownerId
        : (exists(/databases/$(database)/documents/stores/$(storeId))
          ? get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId
          : null);
    }

    function isStoreOwnerOrAdmin(storeId) {
      let ownerId = getStoreOwnerId(storeId);
      return isAuthenticated() &&
        storeId is string &&
        ownerId != null &&
        (ownerId == request.auth.uid || isAdmin());
    }

    function sameStoreRefOnUpdate(newData, oldData) {
      let newStoreRef = getStoreRef(newData);
      let oldStoreId = oldData.storeId;
      let oldRestaurantId = oldData.restaurantId;

      // Legacy-friendly: accept either previous storeId or restaurantId as the stable store reference.
      return (oldStoreId == null && oldRestaurantId == null)
        ? (newStoreRef is string)
        : (newStoreRef == oldStoreId || newStoreRef == oldRestaurantId);
    }

    function categoryBelongsToStore(categoryId, storeId) {
      return exists(/databases/$(database)/documents/categories/$(categoryId)) &&
        (get(/databases/$(database)/documents/categories/$(categoryId)).data.storeId == storeId ||
         get(/databases/$(database)/documents/categories/$(categoryId)).data.restaurantId == storeId);
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalShortString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    // Legacy-compatible: accept hex, css named colors, rgb/rgba and values already persisted by previous builds.
    function isValidStoreColor(value) {
      return value == null || (value is string && value.size() > 0 && value.size() <= 64);
    }

    function isValidStoreFontFamily(value) {
      return value == null ||
        value == 'Inter' ||
        value == 'Roboto' ||
        value == 'Playfair Display' ||
        value == 'Be Vietnam Pro' ||
        value == 'Arial' ||
        value == 'Helvetica' ||
        value == 'system-ui' ||
        (value is string && value.size() > 0 && value.size() <= 64);
    }

    function isValidSizePreset(value) {
      return value == null || value == 'large' || value == 'normal' || value == 'compact' || value == 'medium';
    }

    function isValidCurrency(value) {
      return value == null || value == 'EUR' || value == 'USD' || value == 'VND' || value == 'VNĐ';
    }

    function isValidStoreLoose(data) {
      return data.name is string && data.name.size() > 0 &&
             data.slug is string && data.slug.size() > 0 &&
             data.ownerId is string;
    }

    function isValidStore(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 &&
             data.ownerId is string &&
             isOptionalShortString(data.bio, 500) &&
             isOptionalShortString(data.address, 500) &&
             isOptionalShortString(data.phone, 50) &&
             isOptionalShortString(data.logoUrl, 1024) &&
             isOptionalShortString(data.coverUrl, 1024) &&
             (data.primaryColor == null || isValidStoreColor(data.primaryColor)) &&
             (data.secondaryColor == null || isValidStoreColor(data.secondaryColor)) &&
             (data.themeColor == null || isValidStoreColor(data.themeColor)) &&
             isValidStoreFontFamily(data.fontFamily) &&
             isValidSizePreset(data.sizePreset) &&
             isValidCurrency(data.currency) &&
             (data.menuVisibility == null || data.menuVisibility == 'public' || data.menuVisibility == 'private') &&
             (data.createdAt == null || data.createdAt is string || data.createdAt is timestamp) &&
             (data.updatedAt == null || data.updatedAt is string || data.updatedAt is timestamp) &&
             (data.extra == null || data.extra is map);
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             (data.storeId is string || data.restaurantId is string);
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             (data.shortDescription == null || data.shortDescription is string) &&
             (data.longDescription == null || data.longDescription is string) &&
             (data.hashtags == null || (data.hashtags is list && data.hashtags.size() <= 20)) &&
             (data.variants == null || (data.variants is list && data.variants.size() <= 20)) &&
             data.categoryId is string && (data.storeId is string || data.restaurantId is string);
    }

    function isValidAnalyticsType(type) {
      return type == 'menu_view' || type == 'product_detail_click';
    }

    function isValidAnalyticsEvent(data) {
      return isValidAnalyticsType(data.type) &&
             data.storeId is string &&
             getStoreOwnerId(data.storeId) != null &&
             (data.productId == null || data.productId is string) &&
             (data.slug == null || data.slug is string) &&
             (data.userId == null || data.userId is string) &&
             (data.country == null || data.country is string) &&
             (data.device == null || data.device is string) &&
             (data.menuVisibility == null || data.menuVisibility == 'public' || data.menuVisibility == 'private') &&
             (data.extra == null || data.extra is map);
    }

    // Rules
    match /restaurants/{storeId} {
      allow read: if true; // Publicly readable for menu display
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && (isValidStore(request.resource.data) || isValidStoreLoose(request.resource.data));
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin()) && request.resource.data.ownerId == resource.data.ownerId && (isValidStore(request.resource.data) || isValidStoreLoose(request.resource.data));
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // Backward/forward compatibility for clients reading/writing stores directly.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && (isValidStore(request.resource.data) || isValidStoreLoose(request.resource.data));
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin()) && request.resource.data.ownerId == resource.data.ownerId && (isValidStore(request.resource.data) || isValidStoreLoose(request.resource.data));
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        isValidCategory(request.resource.data) &&
        isStoreOwnerOrAdmin(getStoreRef(request.resource.data));
      allow update: if isAuthenticated() &&
        isValidCategory(request.resource.data) &&
        sameStoreRefOnUpdate(request.resource.data, resource.data) &&
        isStoreOwnerOrAdmin(getStoreRef(request.resource.data));
      allow delete: if isAuthenticated() &&
        isStoreOwnerOrAdmin(getStoreRef(resource.data));
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        isValidProduct(request.resource.data) &&
        isStoreOwnerOrAdmin(getStoreRef(request.resource.data)) &&
        categoryBelongsToStore(request.resource.data.categoryId, getStoreRef(request.resource.data));
      allow update: if isAuthenticated() &&
        isValidProduct(request.resource.data) &&
        sameStoreRefOnUpdate(request.resource.data, resource.data) &&
        isStoreOwnerOrAdmin(getStoreRef(request.resource.data)) &&
        (
          categoryBelongsToStore(request.resource.data.categoryId, getStoreRef(request.resource.data)) ||
          request.resource.data.categoryId == resource.data.categoryId
        );
      allow delete: if isAuthenticated() &&
        isStoreOwnerOrAdmin(getStoreRef(resource.data));
    }

    match /analytics/{eventId} {
      allow create: if isValidAnalyticsEvent(request.resource.data) &&
        request.resource.data.timestamp == request.time;
      allow read: if isAuthenticated() &&
        resource.data.storeId is string &&
        isStoreOwnerOrAdmin(resource.data.storeId);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
