rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: stores (legacy: restaurants)
    // Fields: name, bio, logoUrl, coverUrl, slug, ownerId
    //
    // Collection: categories
    // Fields: name, order, storeId, restaurantId (legacy)
    //
    // Collection: products
    // Fields: name, description, price, imageUrl, isAvailable, categoryId, storeId, restaurantId (legacy)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "qthuan1234@gmail.com" && request.auth.token.email_verified == true));
    }

    function isStoreOwnerOrAdmin(storeId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/restaurants/$(storeId)) &&
        (
          get(/databases/$(database)/documents/restaurants/$(storeId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
    }

    function categoryBelongsToStore(categoryId, storeId) {
      return exists(/databases/$(database)/documents/categories/$(categoryId)) &&
        (get(/databases/$(database)/documents/categories/$(categoryId)).data.storeId == storeId ||
         get(/databases/$(database)/documents/categories/$(categoryId)).data.restaurantId == storeId);
    }

    function isValidStore(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() < 50 &&
             data.ownerId is string;
    }

    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             (data.storeId is string || data.restaurantId is string);
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.categoryId is string && (data.storeId is string || data.restaurantId is string);
    }

    // Rules
    match /restaurants/{storeId} {
      allow read: if true; // Publicly readable for menu display
      allow create: if isAuthenticated() && isValidStore(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin()) && isValidStore(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        isValidCategory(request.resource.data) &&
        isStoreOwnerOrAdmin(request.resource.data.storeId == null ? request.resource.data.restaurantId : request.resource.data.storeId);
      allow update: if isAuthenticated() &&
        isValidCategory(request.resource.data) &&
        ((request.resource.data.storeId != null && request.resource.data.storeId == resource.data.storeId) || (request.resource.data.restaurantId != null && request.resource.data.restaurantId == resource.data.restaurantId)) &&
        isStoreOwnerOrAdmin(request.resource.data.storeId == null ? request.resource.data.restaurantId : request.resource.data.storeId);
      allow delete: if isAuthenticated() &&
        isStoreOwnerOrAdmin(resource.data.storeId == null ? resource.data.restaurantId : resource.data.storeId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        isValidProduct(request.resource.data) &&
        isStoreOwnerOrAdmin(request.resource.data.storeId == null ? request.resource.data.restaurantId : request.resource.data.storeId) &&
        categoryBelongsToStore(request.resource.data.categoryId, request.resource.data.storeId == null ? request.resource.data.restaurantId : request.resource.data.storeId);
      allow update: if isAuthenticated() &&
        isValidProduct(request.resource.data) &&
        ((request.resource.data.storeId != null && request.resource.data.storeId == resource.data.storeId) || (request.resource.data.restaurantId != null && request.resource.data.restaurantId == resource.data.restaurantId)) &&
        isStoreOwnerOrAdmin(resource.data.storeId == null ? resource.data.restaurantId : resource.data.storeId) &&
        categoryBelongsToStore(request.resource.data.categoryId, request.resource.data.storeId == null ? request.resource.data.restaurantId : request.resource.data.storeId);
      allow delete: if isAuthenticated() &&
        isStoreOwnerOrAdmin(resource.data.storeId == null ? resource.data.restaurantId : resource.data.storeId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
