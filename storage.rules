rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for menu images (logo, cover, product photos)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Product uploads must be written under products/{uid}/...
    match /products/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Restaurant assets (logo/cover) must be written under restaurants/{uid}/...
    match /restaurants/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}