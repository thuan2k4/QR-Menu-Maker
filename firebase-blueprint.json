{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Thông tin cơ bản của cửa hàng/dịch vụ",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tên cửa hàng"
        },
        "bio": {
          "type": "string",
          "description": "Giới thiệu ngắn"
        },
        "address": {
          "type": "string",
          "description": "Địa chỉ cửa hàng"
        },
        "logoUrl": {
          "type": "string",
          "description": "URL ảnh đại diện"
        },
        "coverUrl": {
          "type": "string",
          "description": "URL ảnh bìa"
        },
        "slug": {
          "type": "string",
          "description": "Đường dẫn duy nhất cho menu"
        },
        "ownerId": {
          "type": "string",
          "description": "UID của chủ sở hữu"
        },
        "phone": {
          "type": "string",
          "description": "Số điện thoại liên hệ"
        },
        "primaryColor": {
          "type": "string",
          "description": "Màu chủ đạo của menu"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Màu nền phụ của menu"
        },
        "fontFamily": {
          "type": "string",
          "description": "Font hiển thị cho menu"
        },
        "sizePreset": {
          "type": "string",
          "description": "Kích thước hiển thị: large/normal/compact"
        },
        "currency": {
          "type": "string",
          "description": "Đơn vị tiền tệ: EUR/USD/VND"
        },
        "themeColor": {
          "type": "string",
          "description": "Màu chủ đạo (legacy)"
        },
        "menuVisibility": {
          "type": "string",
          "description": "Trạng thái menu: public/private"
        }
      },
      "required": [
        "name",
        "slug",
        "ownerId"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Danh mục sản phẩm",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tên danh mục"
        },
        "order": {
          "type": "integer",
          "description": "Thứ tự hiển thị"
        },
        "storeId": {
          "type": "string",
          "description": "ID cửa hàng sở hữu"
        },
        "restaurantId": {
          "type": "string",
          "description": "ID nhà hàng cũ (legacy)"
        }
      },
      "required": [
        "name",
        "storeId"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Sản phẩm/Món ăn trong menu",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Tên sản phẩm"
        },
        "description": {
          "type": "string",
          "description": "Mô tả chi tiết"
        },
        "price": {
          "type": "number",
          "description": "Giá bán"
        },
        "imageUrl": {
          "type": "string",
          "description": "URL ảnh sản phẩm"
        },
        "categoryId": {
          "type": "string",
          "description": "ID danh mục"
        },
        "storeId": {
          "type": "string",
          "description": "ID cửa hàng"
        },
        "restaurantId": {
          "type": "string",
          "description": "ID nhà hàng cũ (legacy)"
        }
      },
      "required": [
        "name",
        "price",
        "categoryId",
        "storeId"
      ]
    },
    "Analytics": {
      "title": "Analytics",
      "description": "Sự kiện tương tác menu công khai",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Loại sự kiện: menu_view hoặc product_detail_click"
        },
        "storeId": {
          "type": "string",
          "description": "ID cửa hàng"
        },
        "productId": {
          "type": "string",
          "description": "ID sản phẩm (nếu có)"
        },
        "slug": {
          "type": "string",
          "description": "Slug menu public"
        },
        "userId": {
          "type": "string",
          "description": "UID người dùng (nếu đã đăng nhập)"
        },
        "country": {
          "type": "string",
          "description": "Quốc gia suy ra từ locale"
        },
        "device": {
          "type": "string",
          "description": "Thiết bị truy cập: mobile/tablet/desktop"
        },
        "menuVisibility": {
          "type": "string",
          "description": "Trạng thái menu tại thời điểm event"
        },
        "timestamp": {
          "type": "string",
          "description": "Thời điểm ghi event"
        },
        "extra": {
          "type": "object",
          "description": "Metadata bổ sung"
        }
      },
      "required": [
        "type",
        "storeId",
        "timestamp"
      ]
    }
  },
  "firestore": {
    "/restaurants/{storeId}": {
      "schema": "Store",
      "description": "Dữ liệu cửa hàng (collection restaurants giữ tên cũ)"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Dữ liệu danh mục"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Dữ liệu sản phẩm"
    },
    "/analytics/{eventId}": {
      "schema": "Analytics",
      "description": "Dữ liệu tracking menu view và product detail click"
    }
  }
}